# Server Port
PORT=5000

# MongoDB URI (Replace with your MongoDB Atlas or local MongoDB connection string)
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/food-ordering-db?retryWrites=true&w=majority
# Example Local MongoDB: mongodb://localhost:27017/food-ordering-db
MONGODB_URI=mongodb://localhost:27017/food-ordering-db

# JWT Secret Key
JWT_SECRET=super_secret_jwt_key_food_ordering_2026

# Node Environment
NODE_ENV=development
